#
#  ~/.config/ghostty/config -- ghostty configuration file
#

theme = Catppuccin Mocha
config-file = fonts/maple-mono-nl.conf

# --- Window settings
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-inherit-font-size = true
window-save-state = always

maximize = true
initial-window = true
quit-after-last-window-closed = true

# --- Background settings
background-opacity = 0.85
unfocused-split-opacity = 0.6
background-blur = false

# --- Clipboard
clipboard-read = ask
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Cursor
cursor-style = block
cursor-style-blink = false

# --- Quick terminal
quick-terminal-position = top
quick-terminal-autohide = true
quick-terminal-animation-duration = 0
quick-terminal-size = 100%

# --- OS specific configurations
config-file = ?linux.conf
config-file = ?macos.conf

# --- Shell integrations
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# --- Keybinds
config-file = keybind.conf

# --- Command
# command = /run/current-system/sw/bin/bash -lc "nu --login"
# initial-command = /run/current-system/sw/bin/bash -lc "nu --env-config ~/.config/nushell/env.nu --commands 'tms start'"
command = ~/.local/state/nix/profile/bin/zsh --login
initial-command = ~/.local/state/nix/profile/bin/zsh -c "tms start"

